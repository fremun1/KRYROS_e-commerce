# KRYROS E-Commerce Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env files to version control

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
# Set to 'production' in production

# =============================================================================
# DATABASE (PostgreSQL via Prisma)
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/kryros?schema=public

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# TWO-FACTOR AUTHENTICATION (2FA) - CRITICAL FOR 2FA TO WORK
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is used to ENCRYPT TOTP secrets at rest in the database
# WITHOUT THIS, 2FA WILL FAIL WITH ENCRYPTION ERROR
TOTP_ENCRYPTION_KEY=your-32-byte-hex-key-for-totp-encryption

# Fallback: If TOTP_ENCRYPTION_KEY is not set, JWT_SECRET will be used
# but a dedicated key is recommended for production security

# =============================================================================
# REDIS (for caching, rate limiting, lockout persistence)
# =============================================================================
# Required for production - persists login lockout state across restarts
# Without Redis, brute-force protection resets on server restart
REDIS_URL=redis://localhost:6379

# =============================================================================
# RECAPTCHA v3 (Google) - For login/registration bot protection
# =============================================================================
# Get keys from: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Frontend site key (used in Admin-Panel and User-UI)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# =============================================================================
# EMAIL (SMTP) - For notifications, OTP, password reset, 2FA emails
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="KRYROS <noreply@kryros.com>"
APP_URL=https://your-domain.com

# =============================================================================
# FRONTEND URLs (CORS, redirects, etc.)
# =============================================================================
# Admin Panel URL
NEXT_PUBLIC_ADMIN_URL=https://admin.your-domain.com
# User-facing storefront URL
NEXT_PUBLIC_FRONTEND_URL=https://your-domain.com
# API URL (used by Admin-Panel to call backend)
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# =============================================================================
# FILE STORAGE (Cloudinary)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# PAYMENT PROVIDERS (Configure as needed)
# =============================================================================
# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
FLUTTERWAVE_ENCRYPTION_KEY=xxx

# Paystack
PAYSTACK_PUBLIC_KEY=pk_xxx
PAYSTACK_SECRET_KEY=sk_xxx

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_SECRET_KEY=sk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_MODE=sandbox

# =============================================================================
# SMS / WHATSAPP (Twilio, Africa's Talking, etc.)
# =============================================================================
# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1xxx
TWILIO_WHATSAPP_NUMBER=+1xxx

# Africa's Talking (for Zambia/NG)
AFRICASTALKING_USERNAME=xxx
AFRICASTALKING_API_KEY=xxx
AFRICASTALKING_SENDER_ID=KRYROS

# =============================================================================
# PUSH NOTIFICATIONS (Firebase)
# =============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=xxx@your-project.iam.gserviceaccount.com

# =============================================================================
# GEOLOCATION / IP DETECTION (for region restriction)
# =============================================================================
# Uses free ipapi.co and ip-api.com by default
# For production, consider paid services like ipgeolocation.io, maxmind, etc.
# No additional config needed for default providers

# =============================================================================
# OTHER
# =============================================================================
# WhatsApp number for store contact
WHATSAPP_NUMBER=+260969597029

# Codewords (if using preview auth)
CODEWORDS_APP_URL=https://codewords.agemo.ai
CODEWORDS_ACCESS_TOKEN=xxx
CODEWORDS_PROJECT_ID=xxx
CODEWORDS_PREVIEW_AUTH=xxx
CODEWORDS_RUNTIME_URI=xxx