generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid())
  email                    String?                @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?                @unique
  avatar                   String?
  role                     UserRole               @default(CUSTOMER)
  isVerified               Boolean                @default(true)
  isActive                 Boolean                @default(true)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  passwordResetExpires     DateTime?
  passwordResetToken       String?
  twoFactorEnabled         Boolean                @default(false)
  twoFactorSecret          String?
  emailVerificationExpires DateTime?
  emailVerificationToken   String?
  country                  String?
  addresses                Address[]
  creditAccounts           CreditAccount[]
  creditApplications       CreditApplication[]
  creditProfile            CreditProfile?
  notifications            Notification[]
  orders                   Order[]
  refreshTokens            RefreshToken[]
  reviews                  Review[]
  serviceBookings          ServiceBooking[]
  supportTickets           SupportTicket[]
  devices                  UserDevice[]
  roleAssignments          UserRoleAssignment[]
  wallet                   Wallet?
  wholesaleAccount         WholesaleAccount?
  wholesaleApplications    WholesaleApplication[]
  wishlists                WishlistItem[]
  directPayments           DirectPayment[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PendingRegistration {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  password     String
  firstName    String
  lastName     String
  countryCode  String?
  otpCode      String
  otpChannel   String   // 'email' or 'sms'
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([phone])
  @@index([expiresAt])
  @@map("pending_registrations")
}

model UserDevice {
  id        String   @id @default(uuid())
  userId    String?
  fcmToken  String   @unique
  isAdmin   Boolean  @default(false)
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([createdAt])
  @@map("user_devices")
}

model Role {
  id              String               @id @default(uuid())
  name            String               @unique
  description     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  permissions     Permission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  name     String @unique
  resource String
  action   String
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])

  @@map("permissions")
}

model UserRoleAssignment {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Address {
  id             String      @id @default(uuid())
  userId         String?
  type           AddressType @default(SHIPPING)
  firstName      String
  lastName       String
  company        String?
  street         String
  city           String?
  state          String?
  country        String      @default("Zambia")
  zipCode        String?
  phone          String
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  cityId         String?
  cityName       String?
  countryId      String?
  manual         Boolean     @default(false)
  stateId        String?
  stateName      String?
  email          String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[]     @relation("OrderBillingAddress")
  shippingOrders Order[]     @relation("OrderShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  image       String?
  icon        String?
  parentId    String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  showOnHome  Boolean      @default(false)
  brands      Brand[]
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  creditPlans CreditPlan[]
  products    Product[]

  @@map("categories")
}

model Brand {
  name        String
  slug        String       @unique
  logo        String?
  description String?
  website     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  id          Int          @id @default(autoincrement())
  categoryId  String?
  country     String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  creditPlans CreditPlan[]
  products    Product[]

  @@map("brands")
}

model Product {
  id                     String              @id @default(uuid())
  name                   String
  slug                   String              @unique
  description            String
  shortDescription       String?
  price                  Decimal             @db.Decimal(10, 2)
  salePrice              Decimal?            @db.Decimal(10, 2)
  sku                    String              @unique
  barcode                String?
  weight                 Decimal?            @db.Decimal(10, 3)
  isFeatured             Boolean             @default(false)
  isFlashSale            Boolean             @default(false)
  flashSalePrice         Decimal?            @db.Decimal(10, 2)
  flashSaleEnd           DateTime?
  allowCredit            Boolean             @default(false)
  creditMinimum          Decimal?            @db.Decimal(10, 2)
  metaTitle              String?
  metaDescription        String?
  metaKeywords           String?
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  categoryId             String?
  brandId                Int?
  specifications         String?
  creditMessage          String?
  deliveryInfo           String?
  warrantyInfo           String?
  discountPercentage     Int?
  hasFiveYearGuarantee   Boolean             @default(true)
  hasFreeReturns         Boolean             @default(true)
  hasInstallmentOptions  Boolean             @default(true)
  isNew                  Boolean             @default(false)
  rating                 Float?              @default(0)
  reviewCount            Int?                @default(0)
  stockCurrent           Int                 @default(42)
  stockTotal             Int                 @default(50)
  wholesalePrice         Decimal?            @db.Decimal(10, 2)
  fiveYearGuaranteeText  String?
  freeReturnsText        String?
  installmentOptionsText String?
  isBestSeller           Boolean             @default(false)
  isHot                  Boolean             @default(false)
  isTrending             Boolean             @default(false)
  condition              String?             @default("New")
  shippingFee            Decimal?            @db.Decimal(10, 2)
  images                 ProductImage[]
  category               Category?           @relation(fields: [categoryId], references: [id])
  brand                  Brand?              @relation(fields: [brandId], references: [id])
  reviews                Review[]
  wishlistItems          WishlistItem[]
  orderItems             OrderItem[]
  creditPlans            CreditPlan[]
  pickupStocks           PickupStock[]
  serviceBookings        ServiceBooking[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  alt       String?
  isDefault Boolean @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([userId])
  @@map("wishlist_items")
}

model Order {
  id               String    @id @default(uuid())
  orderNumber      String    @unique
  userId           String?
  status           OrderStatus @default(PENDING)
  paymentStatus    String    @default("pending")
  paymentMethod    String?
  subtotal         Decimal   @db.Decimal(10, 2)
  tax              Decimal   @db.Decimal(10, 2)
  shipping         Decimal   @db.Decimal(10, 2)
  total            Decimal   @db.Decimal(10, 2)
  currency         String    @default("USD")
  currencyRate     Decimal   @default(1)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  billingAddressId  String?
  shippingAddressId String?
  guestFcmToken     String?
  items            OrderItem[]
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingAddress   Address?  @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress  Address?  @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  directPayments   DirectPayment[]
  notifications    Notification[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model DirectPayment {
  id              String   @id @default(uuid())
  orderId         String
  userId          String?
  paymentNumber   String   @unique
  amount          Decimal  @db.Decimal(10, 2)
  currency        String
  status          String
  paymentMethod   String?
  transactionId   String?
  transactionDate DateTime?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([paymentNumber])
  @@map("direct_payments")
}

model CreditAccount {
  id                String   @id @default(uuid())
  userId            String
  accountNumber     String   @unique
  creditLimit       Decimal  @db.Decimal(10, 2)
  availableCredit   Decimal  @db.Decimal(10, 2)
  currentBalance    Decimal  @db.Decimal(10, 2)
  interestRate      Decimal  @db.Decimal(5, 2)
  dueDate           DateTime?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditApplications CreditApplication[]
  orders            Order[]

  @@index([userId])
  @@map("credit_accounts")
}

model CreditApplication {
  id              String   @id @default(uuid())
  userId          String
  accountId       String?
  status          String   @default("pending")
  amountRequested Decimal  @db.Decimal(10, 2)
  monthlyIncome   Decimal  @db.Decimal(10, 2)
  employment      String?
  employer        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         CreditAccount? @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@map("credit_applications")
}

model CreditProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  creditScore      Int?
  totalDebt        Decimal  @db.Decimal(10, 2)
  monthlyPayments  Decimal  @db.Decimal(10, 2)
  employmentStatus String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_profiles")
}

model CreditPlan {
  id            String   @id @default(uuid())
  productId     String
  name          String
  months        Int
  interestRate  Decimal  @db.Decimal(5, 2)
  minPayment    Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id])

  @@index([productId])
  @@map("credit_plans")
}

model ServiceBooking {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  date      DateTime
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("service_bookings")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open")
  priority  String   @default("medium")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  data      String   @default("{}")
  targetType String   @default("SINGLE")
  sent      Boolean  @default(false)
  isRead    Boolean  @default(false)
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([sent])
  @@index([scheduledAt])
  @@map("notifications")
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  balance    Decimal  @db.Decimal(10, 2) @default(0)
  currency   String   @default("USD")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WholesaleAccount {
  id                String   @id @default(uuid())
  userId            String   @unique
  businessName      String
  businessLicense   String?
  taxId             String?
  status            String   @default("pending")
  minOrderQuantity  Int      @default(10)
  discountPercent   Decimal  @db.Decimal(5, 2) @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications      WholesaleApplication[]

  @@index([userId])
  @@map("wholesale_accounts")
}

model WholesaleApplication {
  id         String   @id @default(uuid())
  userId     String
  accountId  String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    WholesaleAccount? @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@map("wholesale_applications")
}

model PickupStock {
  id        String   @id @default(uuid())
  productId String
  location  String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([location])
  @@map("pickup_stocks")
}

model Country {
  id             String    @id @default(uuid())
  name           String
  code           String    @unique
  currencyCode   String
  currencySymbol String
  symbolPosition SymbolPosition
  exchangeRate   Decimal   @db.Decimal(10, 4)
  autoRate       Boolean   @default(false)
  lastRateUpdate DateTime?
  isDefault      Boolean   @default(false)
  flag           String?
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @updatedAt
  paymentMethods CountryPaymentMethod[]

  @@map("countries")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_methods")
}

model CountryPaymentMethod {
  id             String        @id @default(uuid())
  countryId      String
  paymentMethodId String
  isActive       Boolean       @default(true)
  country        Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([countryId, paymentMethodId])
  @@map("country_payment_methods")
}

model SmsSupportedCountry {
  id        String   @id @default(uuid())
  name      String
  dialCode  String
  isoCode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_supported_countries")
}

model EmailContact {
  id        String   @id @default(uuid())
  email     String
  name      String
  source    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_contacts")
}

model SmsContact {
  id        String   @id @default(uuid())
  phone     String
  name      String
  source    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_contacts")
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  MANAGER
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SymbolPosition {
  BEFORE
  AFTER
}
